{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Berzh AI",
  "version": "0.1.0",
  "identifier": "com.devthanseemx.berzhai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Berzh AI",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNzdEN0U5RTQ0MEJDREYKUldUZnZFRGs2ZGQzTERZTjRHTy9mMFA2cTFYZVNJaWdKZ1g5RWNMN3hES1ZrVDBDVHBFdlUrdHIK",
      "endpoints": [
        "https://github.com/devthanseemx/berzh-ai/releases/latest/download/latest.json"
      ]
    }
  }
}